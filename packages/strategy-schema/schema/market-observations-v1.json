{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantlens.local/schema/market-observations-v1.json",
  "title": "QuantLens dormant reviewed market observations v1",
  "type": "object",
  "required": [
    "market_observations_version",
    "snapshot_sha256",
    "exchange_calendar_id",
    "exchange_calendar_version",
    "instruments"
  ],
  "additionalProperties": false,
  "properties": {
    "market_observations_version": { "const": "market-observations-v1" },
    "snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "exchange_calendar_id": { "type": "string", "minLength": 1, "pattern": "^[\\x21-\\x7e]+$" },
    "exchange_calendar_version": { "type": "string", "minLength": 1, "pattern": "^[\\x21-\\x7e]+$" },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["symbol", "currency", "sessions"],
        "additionalProperties": false,
        "properties": {
          "symbol": { "type": "string", "pattern": "^[A-Z][A-Z0-9.\\-]{0,14}$" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "sessions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["date", "open", "close"],
              "additionalProperties": false,
              "properties": {
                "date": { "type": "string", "format": "date" },
                "open": { "type": "number", "exclusiveMinimum": 0 },
                "close": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
