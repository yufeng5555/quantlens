{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantlens.local/schema/manifest-v3.json",
  "title": "QuantLens dormant corrected-financial-semantics run manifest v3",
  "description": "Gate E Stop A data contract. Closed schema; no runner, queue, registry or product surface consumes it yet. Fields carried forward from manifest-v0/v1/v2 keep their exact legacy grammar; new Gate E binding hashes use the sha256:-prefixed canonical-JSON grammar of the Gate B payload schemas; artifact entries mirror the frozen ledger-v1 index entry grammar. The three reviewed data-source labels are closed conditional branches that change lineage requirements only, never the v3 financial tuple: SYNTHETIC retains the synthetic snapshot identity and forbids dataset lineage; USER_UPLOADED requires the sealed user dataset identity/manifest under a usr- snapshot id; LICENSED_PROVIDER additionally requires provider, instrument and rights-policy provenance under a lic- snapshot id. Every branch is manifest v3 with DSL 1.2; DSL 1.0/1.1 are never admitted.",
  "type": "object",
  "required": [
    "manifest_id", "manifest_version", "activation_release", "presentation_contract",
    "worker_runtime", "engine_semver", "battery_profile_id", "battery_payload_version",
    "validation_plan_version", "dsl_schema_version", "market_observations_version",
    "ledger_semantics_version", "execution_semantics_version", "execution_cost_model",
    "continuous_path_version", "valuation_ledger_version", "financial_contract_version",
    "execution_implementation", "validator_version", "metric_semantics_version",
    "evidence_view_version", "evidence_semantics_version", "semantic_receipt_version",
    "plan_anchor_version", "holdout_access_protocol", "artifact_producer",
    "spec_hash", "spec_version", "snapshot_id", "snapshot_sha256",
    "plan_anchor_sha256", "financial_contract_sha256", "ledger_id",
    "semantic_receipt_sha256", "temporal_integrity_sha256",
    "final_holdout_execution_audit_sha256", "image_digest", "battery_config_hash",
    "actor_id", "created_at", "result_hash", "data_label",
    "confirmation_receipt_hash", "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_id": { "type": "string", "minLength": 8 },
    "manifest_version": { "const": "v3" },
    "activation_release": { "const": "quantlens-financial-v3" },
    "presentation_contract": { "const": "corrected-financial-semantics-v3-ledger-v1" },
    "worker_runtime": { "const": "quantlens-worker-v3" },
    "engine_semver": { "const": "0.2.0" },
    "battery_profile_id": { "const": "battery-v3" },
    "battery_payload_version": { "const": "battery-v3" },
    "validation_plan_version": { "const": "validation-plan-v3" },
    "dsl_schema_version": { "const": "1.2" },
    "market_observations_version": { "const": "market-observations-v2" },
    "ledger_semantics_version": { "const": "ledger-v1" },
    "execution_semantics_version": { "const": "financial-semantics-v2" },
    "execution_cost_model": { "const": "adverse_effective_fill_price" },
    "continuous_path_version": { "const": "continuous-development-path-v1" },
    "valuation_ledger_version": { "const": "valuation-ledger-v1" },
    "financial_contract_version": { "const": "financial-contract-v1" },
    "execution_implementation": { "const": "adverse-effective-fill-v1" },
    "validator_version": { "const": "financial-semantic-validator-v1" },
    "metric_semantics_version": { "const": "metrics-v2" },
    "evidence_view_version": { "const": "v3" },
    "evidence_semantics_version": { "const": "v3" },
    "semantic_receipt_version": { "const": "semantic-validation-receipt-v1" },
    "plan_anchor_version": { "const": "validation-plan-anchor-v1" },
    "holdout_access_protocol": { "const": "final-holdout-access-v1" },
    "artifact_producer": { "const": "quantlens-engine/0.2.0+battery-v3" },
    "spec_hash": { "$ref": "#/$defs/prefixed_sha256" },
    "spec_version": { "type": "integer", "minimum": 1 },
    "snapshot_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[\\x21-\\x7e]+$" },
    "snapshot_sha256": { "$ref": "#/$defs/bare_sha256" },
    "plan_anchor_sha256": { "$ref": "#/$defs/prefixed_sha256" },
    "financial_contract_sha256": { "$ref": "#/$defs/prefixed_sha256" },
    "ledger_id": { "type": "string", "pattern": "^ldg-[0-9a-f]{64}$" },
    "semantic_receipt_sha256": { "$ref": "#/$defs/prefixed_sha256" },
    "temporal_integrity_sha256": { "$ref": "#/$defs/prefixed_sha256" },
    "final_holdout_execution_audit_sha256": { "$ref": "#/$defs/prefixed_sha256" },
    "image_digest": { "type": "string", "pattern": "^local-runtime-sha256:[0-9a-f]{64}$" },
    "battery_config_hash": { "$ref": "#/$defs/prefixed_sha256" },
    "actor_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*" },
    "result_hash": { "$ref": "#/$defs/prefixed_sha256" },
    "data_label": { "enum": ["SYNTHETIC", "USER_UPLOADED", "LICENSED_PROVIDER"] },
    "confirmation_receipt_hash": { "$ref": "#/$defs/bare_sha256" },
    "dataset_id": { "type": "string", "pattern": "^ds_[0-9a-f]{32}$" },
    "dataset_manifest_sha256": { "$ref": "#/$defs/bare_sha256" },
    "dataset_manifest_version": { "const": "dataset-v2" },
    "provider_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "instrument_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "rights_policy_sha256": { "$ref": "#/$defs/prefixed_sha256" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact_entry" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "data_label": { "const": "SYNTHETIC" } },
        "required": ["data_label"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["dataset_id"] },
            { "required": ["dataset_manifest_sha256"] },
            { "required": ["dataset_manifest_version"] },
            { "required": ["provider_id"] },
            { "required": ["instrument_id"] },
            { "required": ["rights_policy_sha256"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "data_label": { "const": "USER_UPLOADED" } },
        "required": ["data_label"]
      },
      "then": {
        "required": ["dataset_id", "dataset_manifest_sha256"],
        "properties": { "snapshot_id": { "pattern": "^usr-[0-9a-f]{16}$" } },
        "not": {
          "anyOf": [
            { "required": ["dataset_manifest_version"] },
            { "required": ["provider_id"] },
            { "required": ["instrument_id"] },
            { "required": ["rights_policy_sha256"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "data_label": { "const": "LICENSED_PROVIDER" } },
        "required": ["data_label"]
      },
      "then": {
        "required": [
          "dataset_id", "dataset_manifest_sha256", "dataset_manifest_version",
          "provider_id", "instrument_id", "rights_policy_sha256"
        ],
        "properties": { "snapshot_id": { "pattern": "^lic-[0-9a-f]{16}$" } }
      }
    }
  ],
  "$defs": {
    "prefixed_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "bare_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_entry": {
      "type": "object",
      "required": ["artifact_id", "kind", "sha256", "path", "producer"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*-[0-9a-f]{12}$" },
        "kind": {
          "enum": [
            "spec", "validation_plan", "partitions", "financial_contract",
            "valuation_ledger", "development_result", "walk_forward",
            "regime_analysis", "final_holdout_result",
            "final_holdout_execution_audit", "temporal_integrity", "sensitivity",
            "cost_stress", "falsification", "evidence_status", "data_gaps",
            "data_provenance", "snapshot_ref"
          ]
        },
        "sha256": { "$ref": "#/$defs/bare_sha256" },
        "path": { "type": "string", "pattern": "^artifact_[a-z][a-z0-9_]*\\.json$" },
        "producer": { "const": "quantlens-engine/0.2.0+battery-v3" }
      }
    }
  }
}
