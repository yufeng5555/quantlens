{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantlens.local/schema/manifest-v2.json",
  "title": "QuantLens Licensed-data Run Manifest v2",
  "type": "object",
  "required": [
    "manifest_id", "manifest_version", "spec_hash", "spec_version",
    "dsl_schema_version", "snapshot_id", "snapshot_sha256", "dataset_id",
    "dataset_manifest_sha256", "dataset_manifest_version", "provider_id",
    "instrument_id", "rights_policy_sha256", "engine_semver", "image_digest",
    "battery_config_hash", "actor_id", "created_at", "result_hash", "data_label",
    "confirmation_receipt_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_id": { "type": "string", "minLength": 8 },
    "manifest_version": { "const": "v2" },
    "spec_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "spec_version": { "type": "integer", "minimum": 1 },
    "dsl_schema_version": { "const": "1.2" },
    "snapshot_id": { "type": "string", "pattern": "^lic-[0-9a-f]{16}$" },
    "snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dataset_id": { "type": "string", "pattern": "^ds_[0-9a-f]{32}$" },
    "dataset_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dataset_manifest_version": { "const": "dataset-v2" },
    "provider_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "instrument_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "rights_policy_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "engine_semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "image_digest": { "type": "string", "pattern": "^local-runtime-sha256:[0-9a-f]{64}$" },
    "battery_config_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "actor_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*" },
    "result_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "data_label": { "const": "LICENSED_PROVIDER" },
    "confirmation_receipt_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
