{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@schema/*": [
        "../../packages/strategy-schema/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/strategy-schema/ts/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-e2e-release/types/**/*.ts",
    ".next-e2e-release/dev/types/**/*.ts",
    ".next-auth/types/**/*.ts",
    ".next-auth/dev/types/**/*.ts",
    ".next-signedout/types/**/*.ts",
    ".next-signedout/dev/types/**/*.ts",
    ".next-signedout2/types/**/*.ts",
    ".next-signedout2/dev/types/**/*.ts",
    ".next-sandboxcheck/types/**/*.ts",
    ".next-sandboxcheck/dev/types/**/*.ts",
    ".next-audit/types/**/*.ts",
    ".next-audit/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
